# --- Core ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-at-least-32-random-characters-abcdef0123456789
SECRET_KEY_PREVIOUS=
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
PUBLIC_BASE_URL=http://localhost:8000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://xa:xa@localhost:5432/xa_ai
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_RETRIES=5

# --- Redis (REQUIRED in production) ---
REDIS_URL=

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=25
MAX_REQUEST_BODY_MB=30
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=xa-ai

# --- Inference (chat / vision) ---
INFERENCE_BACKEND=stub
INFERENCE_BASE_URL=http://localhost:8080
INFERENCE_API_KEY=
INFERENCE_MODEL_NAME=qwen2.5-1.5b-instruct
INFERENCE_TIMEOUT_SECONDS=120
INFERENCE_MAX_TOKENS=2048
INFERENCE_MAX_RETRIES=3
INFERENCE_CB_FAILURE_THRESHOLD=5
INFERENCE_CB_RECOVERY_SECONDS=30

# --- Specialist backends (leave blank to disable) ---
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL_NAME=
IMAGE_BASE_URL=
AUDIO_ASR_BASE_URL=
AUDIO_ASR_STREAM_URL=
AUDIO_TTS_BASE_URL=
AUDIO_TTS_STREAM_URL=
AUDIO_TTS_VOICE=alloy
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_NAME=
EMBEDDING_BATCH_SIZE=32
MODERATION_BASE_URL=

# --- Voice ---
VOICE_ENABLED=true
VOICE_SAMPLE_RATE_HZ=16000
VOICE_CHUNK_MS=20
VOICE_VAD_AGGRESSIVENESS=2
VOICE_VAD_SILENCE_MS=700
VOICE_VAD_MIN_SPEECH_MS=200
VOICE_MAX_UTTERANCE_SECONDS=30
VOICE_BARGE_IN_ENABLED=true
VOICE_WS_AUTH_STRICT=false

# --- Devices ---
DEVICE_ENABLED=true
DEVICE_PAIRING_TTL_SECONDS=300
DEVICE_COMMAND_TTL_SECONDS=60
DEVICE_MAX_PER_USER=32
DEVICE_HEARTBEAT_SECONDS=30
DEVICE_COMMAND_MAX_ATTEMPTS=3

# --- Automation / Agents ---
AUTOMATION_ENABLED=true
AGENT_MAX_STEPS=12
AGENT_STEP_TIMEOUT_SECONDS=60
AGENT_RUN_TIMEOUT_SECONDS=600
AGENT_REQUIRE_APPROVAL_FOR=shell,file_write,device_command,http_post
AGENT_ALLOWED_TOOLS=fetch_url,math,llm_generate,read_file,write_file,sleep,device_command,http_post
AGENT_MAX_CONCURRENT_PER_USER=3
SCHEDULER_ENABLED=true

# --- SSRF / outbound ---
OUTBOUND_BLOCK_PRIVATE_IPS=true
OUTBOUND_ALLOW_HOSTS=
OUTBOUND_TIMEOUT_SECONDS=15
OUTBOUND_MAX_REDIRECTS=2

# --- Quotas (per user) ---
QUOTA_CHAT_PER_DAY=500
QUOTA_CHAT_TOKENS_PER_DAY=200000
QUOTA_UPLOAD_MB_PER_DAY=200
QUOTA_JOBS_PER_DAY=100
QUOTA_AGENT_RUNS_PER_DAY=50
QUOTA_VOICE_MINUTES_PER_DAY=60

# --- Rate limits (per minute) ---
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_ADMIN_PER_MINUTE=120
RATE_LIMIT_VOICE_PER_MINUTE=60
RATE_LIMIT_DEVICE_PER_MINUTE=120
RATE_LIMIT_AGENT_PER_MINUTE=20

# --- Request handling ---
REQUEST_TIMEOUT_SECONDS=180
STREAM_HEARTBEAT_SECONDS=15

# --- Idempotency ---
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_PURGE_INTERVAL_SECONDS=600

# --- Retention ---
RETENTION_MESSAGES_DAYS=365
RETENTION_AUDIT_DAYS=730
RETENTION_VOICE_SESSIONS_DAYS=30
PURGE_INTERVAL_SECONDS=3600
ORPHAN_VOICE_SESSION_SECONDS=3600

# --- Workers ---
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=300
WORKER_HEARTBEAT_SECONDS=15
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=10
JOB_BACKOFF_JITTER_SECONDS=5

# --- Webhooks ---
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3
WEBHOOK_OUTBOX_BATCH=20
WEBHOOK_OUTBOX_INTERVAL=2
WEBHOOK_OUTBOX_LEASE_SECONDS=60

# --- Training ---
TRAINING_WORKSPACE=./training_workspace
TRAINING_ENABLED=false
